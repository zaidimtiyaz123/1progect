# Local Postgres (docker compose) or keep file:./dev.db if you revert schema provider to sqlite
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurantos?sslmode=disable"
JWT_SECRET="change-me-32-chars-min-random-string!!"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"
PAYMENT_WEBHOOK_SECRET="change-me"
NODE_ENV="development"
# Production (Render/Railway/Vercel): set DATABASE_URL to Neon/Supabase Postgres with ?sslmode=require
# FRONTEND_URL=https://your-frontend.vercel.app
