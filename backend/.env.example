# Local development - use Postgres (recommended) or keep file:./dev.db if you revert provider to sqlite
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurantos?sslmode=disable"
JWT_SECRET="change-me-to-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"
PAYMENT_WEBHOOK_SECRET="change-me"
NODE_ENV="development"
